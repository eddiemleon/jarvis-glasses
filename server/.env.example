# ============ OBLIGATORIO ============
# Contraseña entre la app y el servidor (genera una larga: openssl rand -hex 24)
JARVIS_TOKEN=
# Clave de Anthropic (console.anthropic.com). Recomendada: queda como cerebro principal.
ANTHROPIC_API_KEY=sk-ant-...

# ============ CEREBRO (todo automático) ============
# Solo pega las claves que tengas. Jarvis las detecta, elige solo el modelo más capaz de cada servicio
# y los ordena: Claude -> Gemini -> OpenAI -> OpenRouter -> Groq -> Ollama.
# El primero disponible es el PRINCIPAL; si se queda sin créditos o falla, pasa solo al siguiente y te avisa por voz.
# Con Claude: usa Sonnet (rápido) para charla y Opus (más profundo) para lo complejo, sin que hagas nada.
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
# Ollama en tu PC (gratis, ilimitado): http://IP-DE-TU-PC:11434
OLLAMA_URL=
# Modelo económico para tareas de fondo (traducción, descripciones de fotos). Si tu cuenta no lo tiene, usa Sonnet solo.
# JARVIS_MODEL_FAST=claude-haiku-5-5
JARVIS_OWNER=Eddie
JARVIS_TZ=America/Puerto_Rico
WEB_SEARCH=1

# ============ URL PÚBLICA (para los enlaces de transmisión en vivo) ============
# Si la dejas vacía se deduce de la app. Ejemplo: https://jarvis.midominio.com
PUBLIC_URL=

# ============ TRADINGVIEW ============
# Webhook URL en la alerta: https://TU-SERVIDOR/webhook/tradingview?secret=ESTE_VALOR
TV_SECRET=

# ============ WHATSAPP BUSINESS (Cloud API de Meta) ============
WA_VERIFY_TOKEN=
WA_TOKEN=
WA_PHONE_ID=
WA_APP_SECRET=

# ============ VOZ NEURONAL OPCIONAL (ElevenLabs) ============
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ============ OTROS ============
PORT=8080
DATA_DIR=./data
